# Required server-side values. Do not commit a real .env file.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-a-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# Generate a random value of at least 32 characters. Keep it server-side.
VERSE_API_KEY=replace-with-a-long-random-secret

# Comma-separated E.164 phone numbers that the server may send to.
ALLOWED_RECIPIENTS=+15551234567

# Comma-separated browser origins that may call this API.
# Example for a Chrome extension:
ALLOWED_ORIGINS=chrome-extension://your-extension-id

# Abuse protection. Defaults are used when these are omitted.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10
RECIPIENT_RATE_LIMIT_MAX=3
GLOBAL_DAILY_SEND_LIMIT=25
PORT=3000
